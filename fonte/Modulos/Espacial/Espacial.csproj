<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FAH.Espacial</AssemblyName>
    <RootNamespace>FAH.Espacial</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FAH.Contrato\FAH.Contrato.csproj" Private="false" />
    <!-- audio sessions for the automatic profile; the host already ships NAudio -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- MIT KEMAR HRIRs (public); + SADIE II real heads (York, Apache 2.0, ferramentas\sadie_para_npz.py) -->
    <EmbeddedResource Include="dados\hrtf_*.npz" LogicalName="%(Filename)%(Extension)" />
    <!-- 07/11: Estéreo+ re-pan reused by Som 7.1 (modules don't reference each other: source linked) -->
    <Compile Include="..\Efeitos\Palco.cs" Link="Palco.cs" />
  </ItemGroup>
  <!-- module .dll goes to the host's modulos\ folder -->
  <Target Name="CopiaParaHost" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\FAH\bin\$(Configuration)\net10.0-windows\modulos" SkipUnchangedFiles="true" />
  </Target>
</Project>
