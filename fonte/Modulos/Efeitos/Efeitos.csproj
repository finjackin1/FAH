<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FAH.Efeitos</AssemblyName>
    <RootNamespace>FAH.Efeitos</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FAH.Contrato\FAH.Contrato.csproj" Private="false" />
    <!-- Estéreo+ Auto: same detector as Som 7.1, linked read-only (Espacial is locked, never edit it there) -->
    <Compile Include="..\Espacial\Conteudo.cs" Link="Conteudo.cs" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <!-- module .dll goes to the host's modulos\ folder -->
  <Target Name="CopiaParaHost" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\FAH\bin\$(Configuration)\net10.0-windows\modulos" SkipUnchangedFiles="true" />
  </Target>
</Project>
